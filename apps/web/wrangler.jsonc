{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-globe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The Vite build. Served directly by Cloudflare; only /data/* runs the Worker.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/data/*"]
  },
  "kv_namespaces": [
    {
      // Published by the ingest worker (see README → Deploy). Keys: index.json, countries/{CC}.json
      "binding": "NEWS_DATA",
      "id": "deb7c288814748e393a3e6a801824f6d"
    }
  ],
  "observability": { "enabled": true }
}
