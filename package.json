{
  "name": "news-globe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @news-globe/web dev",
    "build": "pnpm --filter @news-globe/web build",
    "ingest": "pnpm --filter @news-globe/ingest ingest",
    "ingest:watch": "pnpm --filter @news-globe/ingest ingest:watch",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
