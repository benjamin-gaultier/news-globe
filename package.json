{
  "name": "news-globe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @news-globe/web dev",
    "build": "pnpm --filter @news-globe/web build",
    "ingest": "pnpm --filter @news-globe/ingest ingest",
    "ingest:watch": "pnpm --filter @news-globe/ingest ingest:watch",
    "probe": "pnpm --filter @news-globe/ingest probe",
    "cache:merge": "pnpm --filter @news-globe/ingest cache:merge",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm -r --if-present coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
