# Copy to .env (repo root) on the machine that runs the ingest, e.g. the Raspberry Pi.
# With all three Cloudflare values set, every ingest run uploads changed files to KV.
# Account ID: dash.cloudflare.com → Workers & Pages, right-hand column.
CLOUDFLARE_ACCOUNT_ID=
# The KV namespace the Worker reads: the `id` under kv_namespaces in apps/web/wrangler.jsonc.
CLOUDFLARE_KV_NAMESPACE_ID=
# API token with "Account > Workers KV Storage > Edit" only. Never commit it.
CLOUDFLARE_API_TOKEN=

# Optional: where the ingest writes JSON (default: <repo>/data)
# DATA_DIR=/home/pi/news-globe/data

# Optional: before each hourly run, fast-forward this checkout to origin/main and
# reinstall dependencies when they changed (see packages/ingest/src/update.ts).
# AUTO_UPDATE=1

# Optional: after each successful run, add it to the history archive and rebuild
# trends, search, Today and translations in KV (packages/ingest/src/archive-remote.ts),
# instead of waiting for the hourly GitHub workflow.
# ARCHIVE_AFTER_RUN=1

# Optional, with ARCHIVE_AFTER_RUN: Azure AI Translator (free F0 tier) for the
# most-seen headlines. Same values as the repository secrets of the same names.
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=francecentral
